    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <!-- Excel を読み書きする部分・一覧・AI への指示の Excel の段は、Tsuzuri と同じファイルを使う（写しを作らない。2026-11-26） -->
    <Compile Include="..\Tsuzuri\Office\ExcelBridge.cs"><Link>Office\ExcelBridge.cs</Link></Compile>
    <Compile Include="..\Tsuzuri\Office\ExcelBridge.Overview.cs"><Link>Office\ExcelBridge.Overview.cs</Link></Compile>
    <Compile Include="..\Tsuzuri\Office\ExcelInstructions.cs"><Link>Office\ExcelInstructions.cs</Link></Compile>
