    <PackageReference Include="Microsoft.Web.WebView2">
      <Version>1.0.4258.31</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- excel.ps1 も Tsuzuri と同じファイル（環境変数でどちらのアプリから呼ばれたかを見分ける。2026-11-26） -->
    <Content Include="..\Tsuzuri\Ai\excel.ps1"><Link>Ai\excel.ps1</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <!-- 台本の書き方の確かめは Tsuzuri と同じファイルを使う（写しを作らない） -->
    <Content Include="..\Tsuzuri\Ai\excel-guard.ps1"><Link>Ai\excel-guard.ps1</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Ai\hook.ps1"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Ai\talk.ps1"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
