    </Compile>
    <Compile Include="MainWindow.AiTalk.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="MainWindow.AiSetup.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
