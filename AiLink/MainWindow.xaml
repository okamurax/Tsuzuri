<Window x:Class="AiLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI連携ツール"
        WindowStyle="None"
        Height="780" Width="1200"
        MinHeight="400" MinWidth="640"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource ChromeBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Yu Gothic UI, Meiryo UI"
        FontSize="14">

    <DockPanel>

        <!-- 上端の段。タイトルバーの代わり（ドラッグで移動、ダブルクリックで最大化。Tsuzuri と同じ） -->
        <Border DockPanel.Dock="Top" Height="40"
                Background="{StaticResource ChromeBackground}"
                MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <DockPanel Margin="12,0,8,0" VerticalAlignment="Center" LastChildFill="False" TextElement.FontSize="13">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Text="AI連携ツール" />
                <Button DockPanel.Dock="Right" Content="終了(_X)" Style="{StaticResource ToolButton}" Click="Exit_Click" />
            </DockPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBackground}">
            <TextBlock x:Name="StatusText" Margin="14,3,14,3" FontSize="13"
                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Text="" />
        </Border>

        <!-- 作業面。左の列（開いている Excel の一覧）｜仕切り｜AI の欄 -->
        <Border Margin="4,0,4,0" CornerRadius="8"
                BorderBrush="{StaticResource FrameBorder}" BorderThickness="1"
                Background="{StaticResource PageBackground}">
            <Grid x:Name="Layout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="180" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左の列: 開いている Excel のブックとシートの一覧（Views/ExcelListView。MainWindow.Excel.cs） -->
                <Border x:Name="ExcelListHost" Grid.Column="0" Background="{StaticResource SidebarBackground}" />

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              DragCompleted="Layout_DragCompleted" />

                <!-- AI の欄。会話のタブごとの端末（Views/TerminalView。WebView2 の xterm.js と ConPTY）で、PowerShell の中で AI が動く -->
                <Border x:Name="AiPane" Grid.Column="2" Background="{StaticResource PageBackground}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="32" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                            <StackPanel x:Name="AiTabs" Orientation="Horizontal" Margin="8,0,8,0" VerticalAlignment="Center" />
                        </Border>
                        <!-- 下端の細い行。AI に最後に渡した状態を出す。その下に、AI が読むファイルの段 -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AiContextText" Margin="12,4,12,5" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                                           Text="" />
                                <StackPanel x:Name="AiFileLinks" Margin="6,0,6,4" />
                            </StackPanel>
                        </Border>
                        <!-- 上の段: タブごとの端末を重ねて置き、選んでいるものだけを出す。下の段: 利用者と AI が一緒に使う共通ターミナル（出すまでは高さ 0） -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="AiUpperRow" Height="*" />
                                <RowDefinition x:Name="AiShellSplitterRow" Height="0" />
                                <RowDefinition x:Name="AiShellRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="AiTerminals" />
                            <GridSplitter x:Name="AiShellSplitter" Grid.Row="1" Height="4" Visibility="Collapsed"
                                          Style="{StaticResource RowSplitter}" ResizeDirection="Rows"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          DragCompleted="AiShellSplitter_DragCompleted" />
                            <DockPanel x:Name="AiShellPane" Grid.Row="2" Visibility="Collapsed">
                                <Border DockPanel.Dock="Top" Height="26" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                    <DockPanel Margin="12,0,4,0">
                                        <Button x:Name="AiShellClose" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                                                Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                Width="20" Height="20" Padding="0" Focusable="False" VerticalAlignment="Center"
                                                ToolTip="このターミナルを閉じる（中の PowerShell も終わる）" Click="AiShellClose_Click" />
                                        <TextBlock x:Name="AiShellStatus" DockPanel.Dock="Right" Margin="8,0,8,0" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource AccentText}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" Text="共通ターミナル" />
                                    </DockPanel>
                                </Border>
                                <Grid x:Name="AiShellHost" />
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

    </DockPanel>
</Window>
