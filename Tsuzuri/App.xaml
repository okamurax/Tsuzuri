<Application x:Class="Tsuzuri.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Tsuzuri.Views">
    <Application.Resources>

        <!-- ============ 配色（Mattermost の Indigo テーマに合わせる。SPEC 16章） ============ -->
        <SolidColorBrush x:Key="PageBackground"    Color="#101827" />
        <SolidColorBrush x:Key="ChromeBackground"  Color="#192339" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#161E32" />
        <!-- アウトラインの見出しの深さを示す縦線。エディタの縦線（地 #101827 に #1E2638）と同じだけ地から明るくする -->
        <SolidColorBrush x:Key="OutlineGuide"      Color="#262E44" />
        <!-- パーツの区切り線と仕切り。地（#101827〜#192339）に埋もれない程度に明るくする -->
        <SolidColorBrush x:Key="BorderBrushSoft"   Color="#31384A" />
        <SolidColorBrush x:Key="TextPrimary"       Color="#DDDFE4" />
        <SolidColorBrush x:Key="TextMuted"         Color="#93979F" />
        <SolidColorBrush x:Key="AccentBrush"       Color="#4A7CE8" />

        <SolidColorBrush x:Key="HoverFill"         Color="#222B3F" />
        <SolidColorBrush x:Key="PressedFill"       Color="#2C3446" />
        <SolidColorBrush x:Key="SelectionFill"     Color="#2C3446" />

        <!-- サイドバーの文字。Mattermost と同じく本文より一段落とし、選んだ行だけ白くする -->
        <SolidColorBrush x:Key="SidebarText"       Color="#B8BBC2" />
        <SolidColorBrush x:Key="SidebarTextActive" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarHeaderText" Color="#B3B6BC" />
        <!-- 本文の地（#101827）の上でのホバー。サイドバー用の HoverFill より一段暗い -->
        <SolidColorBrush x:Key="CenterHover"       Color="#1C2435" />
        <!-- 作業面（サイドバー・本文・ファイラー）を包む角丸の枠。Mattermost の画面から取った -->
        <SolidColorBrush x:Key="FrameBorder"       Color="#293142" />
        <!-- 入力欄の枠。フォーカスで AccentBrush に変える -->
        <SolidColorBrush x:Key="InputBorder"       Color="#3A4255" />

        <SolidColorBrush x:Key="ThumbFill"         Color="#3A4255" />
        <SolidColorBrush x:Key="ThumbFillHover"    Color="#4E576B" />

        <!-- ============ 平たいツールバーボタン ============ -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <!-- RecognizesAccessKey を立てないと _N がそのまま文字として出る -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource PressedFill}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 青みのあるボタン ============ -->
        <!-- Mattermost の「三次」ボタンと同じく、青い字にごく薄い青の地。載せる・押すと地が濃くなる。
             作る・登録するといった、その場の主な操作に使う -->
        <SolidColorBrush x:Key="AccentText"        Color="#5D89EA" />
        <SolidColorBrush x:Key="AccentFill"        Color="#162137" />
        <SolidColorBrush x:Key="AccentFillHover"   Color="#1C2A47" />
        <SolidColorBrush x:Key="AccentFillPressed" Color="#22325A" />

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Setter Property="Background" Value="{StaticResource AccentFill}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource AccentFillHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource AccentFillPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 細いスクロールバー ============ -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Fill" Margin="2" CornerRadius="4"
                                Background="{StaticResource ThumbFill}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{StaticResource ThumbFillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- つまみを 40px より短くしない（2026-11-03。行の多い文書で 4px ほどになり、掴めなかった。ScrollThumbLength） -->
        <views:ScrollThumbLength x:Key="ScrollThumbLength" MinLength="40" />

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="11" />
            <Setter Property="MinWidth" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.ViewportSize>
                                    <MultiBinding Converter="{StaticResource ScrollThumbLength}">
                                        <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Orientation" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Track.ViewportSize>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollPage}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="11" />
                                <Setter Property="MinHeight" Value="11" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ アウトラインの開閉 ============ -->
        <Style x:Key="ExpandToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow"
                                  Data="M 5,3 L 10,8 L 5,13"
                                  Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ アウトラインの項目 ============ -->
        <!-- Mattermost のチャンネル一覧と同じく、選んだ行は左端に青い帯を立てて文字を白くする -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource SidebarText}" />
            <Setter Property="Padding" Value="2,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Row" Background="Transparent"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  Style="{StaticResource ExpandToggle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}" />

                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 子の段。左に見出しの深さを示す縦線を、開閉の三角の真下から子の段の終わりまで引く（エディタの縦線と同じ。SPEC 7章） -->
                            <Grid x:Name="Children">
                                <Rectangle Width="1" HorizontalAlignment="Left" Margin="10,0,0,0"
                                           Fill="{StaticResource OutlineGuide}" IsHitTestVisible="False" />
                                <ItemsPresenter Margin="13,0,0,0" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{StaticResource SelectionFill}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="4,0,0,0" />
                                <Setter TargetName="Row" Property="Padding" Value="0,5,2,5" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- ============ 境界のつまみ ============ -->
        <!-- Mattermost と同じく、見た目は 1px の線だけ。つかめる幅は広く取り、載せると青くなる。
             既定は縦の線（左右の境界）。上下の境界には RowSplitter を使う -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                                       Fill="{StaticResource BorderBrushSoft}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowSplitter" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center"
                                       Fill="{StaticResource BorderBrushSoft}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Fill" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Line" Property="Height" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 選ぶ欄（コンボ）。エクスポートの画面で使う（2026-10-15） ============ -->
        <!-- 入力欄と同じく、地は本文の地、枠は InputBorder。載せると明るく、開いている・フォーカスがあると青い枠。
             開いた一覧はサイドバーの地に角丸の枠。選んだ項目は地を明るく、載せた項目はホバーの地 -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{StaticResource PageBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,11,0"
                                  Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource TextMuted}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CenterHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionFill}" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextActive}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,28,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,4,0,0" Padding="4" CornerRadius="4"
                                        Background="{StaticResource SidebarBackground}"
                                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mattermost のツールチップ。黒地に白の太めの字、角を丸める -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#000000" CornerRadius="4" Padding="8,4" MaxWidth="420">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
