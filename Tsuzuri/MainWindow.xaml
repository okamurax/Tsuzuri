<Window x:Class="Tsuzuri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tsuzuri"
        Icon="App.ico"
        WindowStyle="None"
        Height="780" Width="1200"
        MinHeight="400" MinWidth="640"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource ChromeBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="./Fonts/#Open Sans, Yu Gothic UI, Meiryo UI"
        FontSize="14">

    <DockPanel>

        <!-- ============ ツールバー (SPEC 11章)。Mattermost の一番上のバーと同じく、線を引かず地色で分ける ============ -->
        <!-- タイトルバーを出さないので、ここの空いているところをタイトルバーの代わりにする（ドラッグで移動、ダブルクリックで最大化。2026-10-17） -->
        <Border DockPanel.Dock="Top" Height="40"
                Background="{StaticResource ChromeBackground}"
                MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <!-- 左から、新規作成と開いている文書に対する操作｜ウィンドウ全体の機能（ランチャー・AI）｜終了。全部を左に寄せる（2026-11-01。前は右端、その前はページの上端の段に置いていた） -->
            <DockPanel Margin="8,0,8,0" VerticalAlignment="Center" LastChildFill="False"
                       TextElement.FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <Button Content="新規作成(_O)" Style="{StaticResource ToolButton}" Click="New_Click"
                            ToolTip="Markdown のファイルを作って、新しい画面（タブ）で開く（何も開いていない画面なら、その画面で）。今あるファイルを選んだら、書き換えずにそれを開く" />
                    <Button Content="保存(_S)"   Style="{StaticResource ToolButton}" Click="Save_Click" />
                    <Button Content="サブページ作成(_E)" Style="{StaticResource ToolButton}" Click="Extract_Click"
                            ToolTip="選択した範囲をサブページに移し、その場にリンクを残す。選択が無ければ、カーソルの行の文字をリンクにして空のサブページを作る" />
                    <Button Content="サブページ解除(_R)" Style="{StaticResource ToolButton}" Click="Inline_Click"
                            ToolTip="今開いているサブページを解除し、その中身を親のページのリンクの場所に戻す" />
                    <Button Content="孤立ページ(_U)" Style="{StaticResource ToolButton}" Click="Unreferenced_Click"
                            ToolTip="ファイルからリンクを辿って行き着けないサブページを探す" />
                    <Button Content="未参照の添付(_N)" Style="{StaticResource ToolButton}" Click="UnreferencedAttachments_Click"
                            ToolTip="添付フォルダのファイルのうち、本文のどこからもリンクされていないものを探す" />
                    <Button Content="図を追加(_D)" Style="{StaticResource ToolButton}" Click="InsertDrawing_Click"
                            ToolTip="図エディタで直線・四角・丸・文字・寸法線を描き、カーソルの位置に図として入れる。入れた図は押すと描き直せる" />
                    <Button Content="WordPress(_P)" Style="{StaticResource ToolButton}" Click="WordPress_Click"
                            ToolTip="WordPress の記事を選んで開く・開いている .md を新しい記事にする。WordPress への反映は、このメニューの「アップロード」だけ（保存では送らない）" />
                    <Button Content="エクスポート(_W)" Style="{StaticResource ToolButton}" Click="Export_Click"
                            ToolTip="Word 文書 (.docx) に書き出す。範囲・用紙・向き・余白を選んでから。サブページは本文に戻し、添付は隣のフォルダにコピーする" />
                    <Border Width="1" Height="16" Margin="8,0,8,0" VerticalAlignment="Center" Background="{StaticResource BorderBrushSoft}" />
                    <!-- Tag は MarkdownView.LauncherToggleTag。ランチャーの外を押すと閉じるが、このボタンは除く -->
                    <Button x:Name="LauncherButton" Content="ランチャー(_L)" Style="{StaticResource ToolButton}" Click="Launcher_Click"
                            Tag="LauncherToggle"
                            ToolTip="ランチャーとファイラーを、本文の上半分に重ねて出す。もう一度押すと閉じる" />
                    <Button Content="AI(_A)" Style="{StaticResource ToolButton}" Click="Ai_Click"
                            ToolTip="右に AI の欄を出し入れする。Claude Code と話して、開いている文書を直させる。もう一度押すと隠す（会話は残る）" />
                    <Border Width="1" Height="16" Margin="8,0,8,0" VerticalAlignment="Center" Background="{StaticResource BorderBrushSoft}" />
                    <Button Content="終了(_X)"   Style="{StaticResource ToolButton}" Click="Exit_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 画面のタブ（2026-10-31）。ツールバーの一段下。開いている画面のタブと「＋」、右端に休止している画面のタブ。押すとその画面を前に出す ============ -->
        <!-- ツールバーに並べると右へ行き過ぎたので段を分けた。空いているところはツールバーと同じく、ドラッグで移動・ダブルクリックで最大化。中身は MainWindow.Windows.cs が組む -->
        <Border DockPanel.Dock="Top" Height="30"
                Background="{StaticResource ChromeBackground}"
                MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <!-- 左に開いている画面のタブと「＋」、右端に休止している画面のタブ（2026-11-01） -->
            <DockPanel Margin="8,0,8,2" VerticalAlignment="Center" LastChildFill="False" TextElement.FontSize="13">
                <StackPanel x:Name="SuspendedList" DockPanel.Dock="Right" Orientation="Horizontal" />
                <StackPanel x:Name="WindowList" Orientation="Horizontal" />
            </DockPanel>
        </Border>

        <!-- ============ ステータスバー。角丸の作業面の外、紺の枠の上に出す ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ChromeBackground}">
            <Grid Margin="14,3,14,3" TextElement.FontSize="13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Text="ツールバーの「ランチャー」からファイルを選ぶか、「新規作成」で作ってください。" />

                <!-- 未保存の印。保存はファイル単位なので、ページごとではなくここに1つ出す -->
                <TextBlock x:Name="DirtyText" Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="● 未保存"
                           Visibility="Collapsed" />

                <TextBlock x:Name="SavedText" Grid.Column="2"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" Text="最終保存 —" />
            </Grid>
        </Border>

        <!-- ============ サイドバー + 本文 + ファイラー ============ -->
        <!-- Mattermost と同じく、作業面全体を角の丸い1枚の板にして、紺の枠の中に少し浮かせる。
             Border の角丸は中身を切り抜かないので、中の Grid は大きさが変わるたびに角丸の形で切り抜く -->
        <Border Margin="4,0,4,0" CornerRadius="8"
                BorderBrush="{StaticResource FrameBorder}" BorderThickness="1"
                Background="{StaticResource SidebarBackground}">
        <Grid x:Name="Workspace" SizeChanged="Workspace_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="190" MinWidth="110" />
                <ColumnDefinition x:Name="SplitterColumn" Width="4" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition x:Name="AiSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="AiColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- アウトライン (SPEC 7章) -->
            <Border x:Name="Sidebar" Grid.Column="0"
                    Background="{StaticResource SidebarBackground}">
                <DockPanel>
                    <!-- アウトラインを開く・たたむボタン (SPEC 7章。2026-11-04。前は見出しの検索欄だった)。
                         サイドバーの一番上に置き、エディタの検索欄の段と高さ・下の線をそろえる。
                         ボタンは記号だけ（何をするかはツールチップ）。すべてたたむ・すべて開くの2つを右に寄せる（2026-11-06。見出し n まで開く 1 2 3 はやめた） -->
                    <Border x:Name="OutlineFoldArea" DockPanel.Dock="Top" Height="32"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                            Margin="0,0,0,6" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="10,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="OutlineFoldAll" Tag="0" Content="⊟" FontFamily="Segoe UI Symbol" FontSize="15"
                                    ToolTip="すべてたたむ（いちばん上の見出しだけにする）"
                                    Style="{StaticResource ToolButton}" MinWidth="28" Padding="3,0,3,0" Margin="0,0,2,0"
                                    Focusable="False" Click="OutlineFold_Click" />
                            <Button x:Name="OutlineExpandAll" Tag="99" Content="⊞" FontFamily="Segoe UI Symbol" FontSize="15"
                                    ToolTip="すべて開く"
                                    Style="{StaticResource ToolButton}" MinWidth="28" Padding="3,0,3,0"
                                    Focusable="False" Click="OutlineFold_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 見出しのブックマーク (SPEC 7章)。新しいものが上。空なら出さない -->
                    <Border x:Name="HeadingBookmarkPanel" DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1"
                            Margin="0,0,0,6" Padding="0,0,0,6">
                        <ScrollViewer MaxHeight="240"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="HeadingBookmarkList" />
                        </ScrollViewer>
                    </Border>

                    <!-- 上にアウトラインの木、下に見出しの履歴（SPEC 7章。2026-10-29）。仕切りは動かせ、ダブルクリックで半分ずつ -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="OutlineRow" Height="*" MinHeight="60" />
                            <RowDefinition Height="4" />
                            <RowDefinition x:Name="HistoryRow" Height="*" MinHeight="60" />
                        </Grid.RowDefinitions>

                        <!-- 横スクロールを止めて、項目の幅をサイドバーに収める。
                             そうしないと長い見出しで行が伸び、右端の ＋ / • が外に押し出される -->
                        <Grid Grid.Row="0">
                            <TreeView x:Name="OutlineTree" Padding="6,0,6,12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="4" Style="{StaticResource RowSplitter}" ResizeDirection="Rows"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      DragCompleted="HistorySplitter_DragCompleted"
                                      MouseDoubleClick="HistorySplitter_MouseDoubleClick" />

                        <!-- 履歴。左に本文で踏んだ見出し、右にリンクで移ってきたときのリンク元（2026-11-08）。
                             新しいものから上に積み、押すとそこへ移る。題と空のときの案内は出さない。名前は折り返す -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="HeadingHistoryScroll" Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="HeadingHistoryList" Margin="0,6,0,12" />
                            </ScrollViewer>

                            <Border Grid.Column="1" Background="{StaticResource BorderBrushSoft}" Margin="0,6,0,6" />

                            <ScrollViewer x:Name="LinkHistoryScroll" Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="LinkHistoryList" Margin="0,6,0,12" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          DragCompleted="Layout_DragCompleted" />

            <!-- スタック表示のホスト (SPEC 6章)。本文へのドロップ = リンク挿入 (SPEC 9章) -->
            <Border x:Name="StackHost" Grid.Column="2"
                    ClipToBounds="True"
                    Background="{StaticResource PageBackground}">
                <Grid>
                    <!-- 上半分にランチャーを重ねるための段。ページの並びは2段にまたがる（2026-10-31） -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 左に帯（横スクロールの入れ物。ページに幅を残すところまで）、残りにページ（SPEC 6章。2026-10-27） -->
                    <DockPanel x:Name="StackPanelHost" Grid.RowSpan="2" LastChildFill="True"
                               SizeChanged="StackPanelHost_SizeChanged" />

                    <!-- ランチャーとファイラー (SPEC 4章・9章)。2つで1つの画面。左がランチャー、右がファイラー。
                         本文の場所の上半分に、幅いっぱいで重ねて出す。下半分のエディタは見えたままで、ファイラーからドラッグできる。
                         エディタはそのままで、閉じれば全部また見える（MainWindow.Overlays.cs。2026-10-31。
                         前は最前面の独立したウィンドウ、その前は本文の右側に滑らせて重ねていた）。
                         出している間はフォーカスをここへ移す（覆われた本文に打ち込まないため）ので、Focusable にする -->
                    <Border x:Name="LauncherHost" Grid.Row="0" Visibility="Collapsed"
                            Focusable="True" FocusVisualStyle="{x:Null}"
                            Background="{StaticResource SidebarBackground}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition x:Name="FilerColumn" Width="300" MinWidth="180" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="LauncherSlot" Grid.Column="0" />

                            <GridSplitter Grid.Column="1" Width="4"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          DragCompleted="Layout_DragCompleted" />

                            <Border x:Name="FilerHost" Grid.Column="2" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- AI の欄 (SPEC 19章)。「AI」で出し入れする。中は会話のタブごとの端末（Views/TerminalView。WebView2 の xterm.js と ConPTY）で、PowerShell の中で Claude Code が動く -->
            <GridSplitter x:Name="AiSplitter" Grid.Column="3" Width="4" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          DragCompleted="AiSplitter_DragCompleted" />

            <Border x:Name="AiPane" Grid.Column="4" Visibility="Collapsed" Background="{StaticResource PageBackground}">
                <DockPanel>
                    <!-- 上端の段。本文の検索欄の段と高さ・下の線をそろえる。会話（端末）のタブと「＋」（2026-10-26） -->
                    <Border DockPanel.Dock="Top" Height="32"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                        <StackPanel x:Name="AiTabs" Orientation="Horizontal" Margin="8,0,8,0" VerticalAlignment="Center" />
                    </Border>
                    <!-- 下端の細い行。Claude に最後に渡した状態（ファイル・ページ・カーソルの行）を出す（2026-10-26。前は上端の段） -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock x:Name="AiContextText" Margin="12,4,12,5" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                                       Text="Claude に話しかけると、渡したファイルとカーソルの位置をここに出します" />
                            <!-- Claude が読むファイル。上の段は Claude Code が自分で読むもの、下の段は Tsuzuri が渡すもの。.md は Tsuzuri で添付フォルダを作らずに開く（2026-11-08） -->
                            <StackPanel x:Name="AiFileLinks" Margin="6,0,6,4" />
                        </StackPanel>
                    </Border>
                    <!-- 上の段: タブごとの端末を重ねて置き、選んでいるものだけを出す（外すと WebView2 が作り直しになるため、隠すだけにする）。
                         下の段: 利用者と Claude が一緒に使うターミナル（2026-11-08。MainWindow.AiShell.cs）。出すまでは高さ 0 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="AiUpperRow" Height="*" />
                            <RowDefinition x:Name="AiShellSplitterRow" Height="0" />
                            <RowDefinition x:Name="AiShellRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="AiTerminals" />
                        <GridSplitter x:Name="AiShellSplitter" Grid.Row="1" Height="4" Visibility="Collapsed"
                                      Style="{StaticResource RowSplitter}" ResizeDirection="Rows"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      DragCompleted="AiShellSplitter_DragCompleted" />
                        <DockPanel x:Name="AiShellPane" Grid.Row="2" Visibility="Collapsed">
                            <!-- 上の線は引かない（すぐ上の仕切りの線と2重になったため。2026-11-08）。下の線で端末と分ける -->
                            <Border DockPanel.Dock="Top" Height="26" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                <DockPanel Margin="12,0,4,0">
                                    <Button x:Name="AiShellClose" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                                            Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                            Width="20" Height="20" Padding="0" Focusable="False" VerticalAlignment="Center"
                                            ToolTip="このターミナルを閉じる（中の PowerShell も終わる）" Click="AiShellClose_Click" />
                                    <TextBlock x:Name="AiShellStatus" DockPanel.Dock="Right" Margin="8,0,8,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource AccentText}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="共通ターミナル（Claude も文字を置く。Enter は自分で押す）" />
                                </DockPanel>
                            </Border>
                            <Grid x:Name="AiShellHost" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

        </Grid>
        </Border>

    </DockPanel>
</Window>
