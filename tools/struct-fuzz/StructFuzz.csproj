<Project Sdk="Microsoft.NET.Sdk">
  <!-- 見出しの節を動かす・回す・消すの確かめ（tools/struct-fuzz.sh から動かす）。解析は本体のコードをそのままコンパイルする -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <NoWarn>CS0162;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Tsuzuri/Markdown/DocumentModel.cs" />
    <Compile Include="../../Tsuzuri/Markdown/InlineSpan.cs" />
    <Compile Include="../../Tsuzuri/Markdown/LineInfo.cs" />
    <Compile Include="../../Tsuzuri/Markdown/LineKind.cs" />
    <Compile Include="../../Tsuzuri/Markdown/MarkdownParser.cs" />
    <Compile Include="../../Tsuzuri/Markdown/TableModel.cs" />
    <!-- 本体の Tsuzuri.csproj と同じ版にする -->
    <PackageReference Include="Markdig" Version="0.33.0" />
  </ItemGroup>
</Project>
